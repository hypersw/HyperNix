From: KRdp displayless experiment <noreply@example.invalid>
Subject: [PATCH] Keep the H.264 stream from stalling when acknowledgements stop

The submission loop only sends while fewer frames than the in-flight window are
unacknowledged, and the encoder, once paused by a backed-up queue, resumes only
after a send empties that queue. If acknowledgements stop, nothing is ever sent
again: the queue stays full, the encoder stays paused, and the client is left
with its cursor over a black screen. Observed on an mstsc connection right after
its GFX channel reset, with the encoder paused for 13 seconds until the user
gave up.

6.8.1 honours a FrameAcknowledge whose queue depth suspends acknowledgements;
this logs when that changes. On top, clear frames in flight if the window stays
full with no acknowledgement for a second. And on a GFX channel reset, drop the
frames already encoded for the old surface, not only the ones in flight, and
let the encoder run again.

diff --git a/src/VideoStream.cpp b/src/VideoStream.cpp
index 1048af0..7a26ddd 100644
--- a/src/VideoStream.cpp
+++ b/src/VideoStream.cpp
@@ -54,6 +54,10 @@ constexpr double MaximumValidRttMs = 60000.0; // ignore garbage RTT samples
 
 constexpr qsizetype HighQueueCount = 1; // Level of frames in the pending-send queue that pauses frames pre-encoder; past this point a newer frame is worth more than a queued one
 constexpr qsizetype LowQueueCount = 1; // Level of frames in the pending-send queue that resumes the encoder
+// How long the in-flight window may stay full without a single acknowledgement
+// before it is assumed lost and cleared, so the stream recovers instead of
+// stalling for good.
+constexpr clk::steady_clock::duration AckStallTimeout = clk::milliseconds(1000);
 
 constexpr uint32_t ProgressiveCodecContextId = 1;
 
@@ -171,6 +175,9 @@ public:
     QSet<uint32_t> pendingFrames;
     bool frameAcknowledgementSuspended = false;
     std::mutex pendingFramesMutex;
+    // Last time the in-flight window made progress: a frame acknowledged,
+    // the window emptied, or the GFX channel reset. Guarded by pendingFramesMutex.
+    clk::steady_clock::time_point lastAckProgress = clk::steady_clock::now();
 
     std::atomic_int requestedFrameRate = 60;
     std::atomic<qsizetype> maxInFlight{MaximumInFlightFrames}; // recomputed from RTT on rttChanged
@@ -537,9 +544,20 @@ uint32_t VideoStream::onCapsAdvertise(const RDPGFX_CAPS_ADVERTISE_PDU *capsAdver
         d->capsConfirmed = false;
         d->surface->pendingReset = true;
         destroySurface();
-        std::lock_guard lock(d->pendingFramesMutex);
-        d->pendingFrames.clear();
-        d->frameAcknowledgementSuspended = false;
+        {
+            std::lock_guard lock(d->pendingFramesMutex);
+            d->pendingFrames.clear();
+            d->frameAcknowledgementSuspended = false;
+            d->lastAckProgress = clk::steady_clock::now();
+        }
+        // Frames encoded for the old surface would hold the queue - and with it
+        // the paused encoder - while waiting for capacity. Drop them and let the
+        // encoder run again.
+        {
+            std::lock_guard lock(d->frameQueueMutex);
+            d->frameQueue.clear();
+        }
+        QMetaObject::invokeMethod(this, &VideoStream::updateBackpressure, Qt::QueuedConnection);
     }
 
     auto capsSets = capsAdvertise->capsSets;
@@ -634,8 +652,13 @@ uint32_t VideoStream::onFrameAcknowledge(const RDPGFX_FRAME_ACKNOWLEDGE_PDU *fra
     auto id = frameAcknowledge->frameId;
 
     std::lock_guard lock(d->pendingFramesMutex);
+    d->lastAckProgress = clk::steady_clock::now();
 
-    d->frameAcknowledgementSuspended = frameAcknowledge->queueDepth == SUSPEND_FRAME_ACKNOWLEDGEMENT;
+    const bool suspended = frameAcknowledge->queueDepth == SUSPEND_FRAME_ACKNOWLEDGEMENT;
+    if (suspended != d->frameAcknowledgementSuspended) {
+        qCInfo(KRDP) << (suspended ? "Client suspended frame acknowledgements" : "Client resumed frame acknowledgements");
+    }
+    d->frameAcknowledgementSuspended = suspended;
     if (d->frameAcknowledgementSuspended) {
         d->pendingFrames.clear();
         return CHANNEL_RC_OK;
@@ -910,7 +933,24 @@ void VideoStream::updateAdaptiveQuality()
 bool VideoStream::hasInFlightCapacity() const
 {
     std::lock_guard lock(d->pendingFramesMutex);
-    return d->pendingFrames.size() < d->maxInFlight.load();
+    if (d->frameAcknowledgementSuspended || d->pendingFrames.isEmpty()) {
+        d->lastAckProgress = clk::steady_clock::now();
+        return true;
+    }
+    if (d->pendingFrames.size() < d->maxInFlight.load()) {
+        return true;
+    }
+    // The window is full. If nothing has been acknowledged for a while, the
+    // acknowledgements are not coming - a client that stopped acking, or acks
+    // lost across a GFX reset - and the encoder, paused by the backed-up queue,
+    // would never resume. Forget the frames in flight and carry on.
+    if (clk::steady_clock::now() - d->lastAckProgress > AckStallTimeout) {
+        qCWarning(KRDP) << "No frame acknowledged for" << clk::duration_cast<clk::milliseconds>(AckStallTimeout).count() << "ms; dropping" << d->pendingFrames.size() << "frames in flight";
+        d->pendingFrames.clear();
+        d->lastAckProgress = clk::steady_clock::now();
+        return true;
+    }
+    return false;
 }
 
 void VideoStream::sendFrame(const VideoFrame &frame)
