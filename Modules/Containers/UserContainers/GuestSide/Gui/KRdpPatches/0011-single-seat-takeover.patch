+void SessionController::activateWrapper(SessionWrapper *wrapper)
+{
+    if (!wrapper) {
+        return;
+    }
+    const auto virtualMonitor = wrapper->takePendingVirtualMonitor();
+    if (!virtualMonitor) {
+        qWarning() << "KRDP-TAKEOVER: authenticated wrapper lacks a valid initial layout" << wrapper;
+        if (wrapper->connection) {
+            wrapper->connection->close();
+        }
+        return;
+    }
+
+    qInfo().nospace() << "KRDP-TAKEOVER: activating wrapper=" << wrapper
+                      << " output=" << virtualMonitor->name;
+    m_pendingWrapper = nullptr;
+    m_activeWrapper = wrapper;
+    wrapper->setVirtualMonitor(*virtualMonitor);
+    wrapper->startSession();
+}
+
+void SessionController::requestTakeover(SessionWrapper *wrapper)
+{
+    if (!wrapper || wrapper == m_activeWrapper || wrapper == m_closingWrapper) {
+        return;
+    }
+
+    if (!m_activeWrapper) {
+        activateWrapper(wrapper);
+        return;
+    }
+
+    if (m_pendingWrapper && m_pendingWrapper != wrapper && m_pendingWrapper->connection) {
+        qWarning() << "KRDP-TAKEOVER: replacing an already pending wrapper" << m_pendingWrapper
+                   << "with" << wrapper;
+        m_pendingWrapper->connection->close();
+    }
+    m_pendingWrapper = wrapper;
+    m_closingWrapper = m_activeWrapper;
+    qInfo() << "KRDP-TAKEOVER: requesting controlled close of old wrapper" << m_closingWrapper
+            << "for pending wrapper" << m_pendingWrapper;
+    if (m_closingWrapper->connection) {
+        m_closingWrapper->connection->close();
+        m_closeTimer->start(3000);
+    } else {
+        onWrapperConnectionDestroyed(m_closingWrapper);
+    }
+}
+
+void SessionController::onWrapperConnectionDestroyed(SessionWrapper *wrapper)
+{
+    if (wrapper != m_activeWrapper && wrapper != m_closingWrapper) {
+        if (wrapper == m_pendingWrapper) {
+            m_pendingWrapper = nullptr;
+        }
+        removeWrapper(wrapper);
+        return;
+    }
+
+    m_closeTimer->stop();
+    m_activeWrapper = nullptr;
+    m_closingWrapper = wrapper;
+    qInfo() << "KRDP-TAKEOVER: old connection destroyed; waiting for output cleanup" << wrapper;
+    wrapper->runOutputLifecycleHandler(QStringLiteral("down"));
+    m_outputCleanupTimer->start(5000);
+}
+
+void SessionController::onOutputLifecycleFinished(SessionWrapper *wrapper, const QString &action, bool success)
+{
+    if (action != u"down"_s || wrapper != m_closingWrapper) {
+        return;
+    }
+
+    m_outputCleanupTimer->stop();
+    qInfo() << "KRDP-TAKEOVER: old output cleanup finished wrapper=" << wrapper << "success=" << success;
+    m_closingWrapper = nullptr;
+    removeWrapper(wrapper);
+    if (success && m_pendingWrapper) {
+        activateWrapper(m_pendingWrapper);
+    } else if (!success && m_pendingWrapper) {
+        qWarning() << "KRDP-TAKEOVER: refusing pending session after failed old-output cleanup" << m_pendingWrapper;
+        if (m_pendingWrapper->connection) {
+            m_pendingWrapper->connection->close();
+        }
+        m_pendingWrapper = nullptr;
+    }
+}
+
+void SessionController::removeWrapper(SessionWrapper *wrapper)
+{
+    if (!wrapper) {
+        return;
+    }
+    m_wrappers.erase(std::remove_if(m_wrappers.begin(),
+                                    m_wrappers.end(),
+                                    [wrapper](const std::unique_ptr<SessionWrapper> &entry) {
+                                        return entry.get() == wrapper;
+                                    }),
+                     m_wrappers.end());
+}
