 {
     qCDebug(KRDP) << "Closing Plasma Remote Session";
+    // A transport loss can omit a final RDP key-release.  KWin maintains key
+    // state independently, so release all modifiers before this fake-input
+    // object disappears instead of leaving Meta/Shift/Alt stuck in Plasma.
+    for (uint keycode : {KEY_LEFTCTRL, KEY_RIGHTCTRL, KEY_LEFTSHIFT, KEY_RIGHTSHIFT,
+                         KEY_LEFTALT, KEY_RIGHTALT, KEY_LEFTMETA, KEY_RIGHTMETA}) {
+        d->remoteInterface->keyboard_key(keycode, 0);
+    }
 }

