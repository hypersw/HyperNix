+                // a 1368x912 monitor with dpr 2, not 2736x1824 at dpr 2 (which
+                // would render 5472x3648).
+                const qreal scale = (clientScale >= 1.0 && clientScale <= 5.0) ? clientScale : monitor.dpr;
