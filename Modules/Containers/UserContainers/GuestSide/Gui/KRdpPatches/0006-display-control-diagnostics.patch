@@ -0,0 +1,18 @@
+#pragma once
+#include <freerdp/server/disp.h>
+
+namespace KRdp
+{
+class RdpConnection;
+class DisplayControl
+{
+public:
+    explicit DisplayControl(RdpConnection *session);
+    ~DisplayControl();
+    bool initialize();
+    void close();
+private:
+    RdpConnection *m_session;
+    DispServerContext *m_context = nullptr;
+};
+}
--- /dev/null
+++ b/src/DisplayControl.cpp
@@ -0,0 +1,62 @@
+#include "DisplayControl.h"
+#include "PeerContext_p.h"
+#include "RdpConnection.h"
+#include "krdp_logging.h"
+#include <freerdp/server/disp.h>
+#include <freerdp/peer.h>
+
+using namespace KRdp;
+
+static UINT receiveMonitorLayout(DispServerContext *context, const DISPLAY_CONTROL_MONITOR_LAYOUT_PDU *pdu)
+{
+    if (pdu->NumMonitors != 1) {
+        qCWarning(KRDP) << "KRDP-DISPLAY-CONTROL: monitor count" << pdu->NumMonitors;
+        return CHANNEL_RC_BAD_CHANNEL;
+    }
+    const auto &monitor = pdu->Monitors[0];
+    qCWarning(KRDP) << "KRDP-DISPLAY-CONTROL: layout" << monitor.Width << 'x' << monitor.Height
+                     << "physical=" << monitor.PhysicalWidth << 'x' << monitor.PhysicalHeight
+                     << "desktopScale=" << monitor.DesktopScaleFactor << "deviceScale=" << monitor.DeviceScaleFactor;
+    return CHANNEL_RC_OK;
+}
+
+DisplayControl::DisplayControl(RdpConnection *session)
+    : m_session(session)
+{
+}
+
+DisplayControl::~DisplayControl()
+{
+    close();
+}
+
+bool DisplayControl::initialize()
+{
+    if (m_context) {
+        return true;
+    }
+    auto peerContext = reinterpret_cast<PeerContext *>(m_session->rdpPeer()->context);
+    m_context = disp_server_context_new(peerContext->virtualChannelManager);
+    if (!m_context) {
+        return false;
+    }
+    m_context->rdpcontext = m_session->rdpPeer()->context;
+    m_context->DispMonitorLayout = receiveMonitorLayout;
+    m_context->MaxNumMonitors = 1;
+    m_context->MaxMonitorAreaFactorA = 8192;
+    m_context->MaxMonitorAreaFactorB = 8192;
+    if (m_context->Open(m_context) != CHANNEL_RC_OK || m_context->DisplayControlCaps(m_context) != CHANNEL_RC_OK) {
+        close();
+        return false;
+    }
+    qCWarning(KRDP) << "KRDP-DISPLAY-CONTROL: advertised";
+    return true;
+}
+
+void DisplayControl::close()
+{
+    if (m_context) {
+        disp_server_context_free(m_context);
+        m_context = nullptr;
+    }
+}
