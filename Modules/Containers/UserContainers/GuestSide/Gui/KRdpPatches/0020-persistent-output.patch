         // 6.8 never looks at the client's own desktop: an explicit
         // --virtual-monitor wins, and otherwise a fixed 1024x768 is used. By
         // the time a connection reaches Activated its capabilities have been
@@ -298,7 +452,10 @@ void SessionController::onNewConnection(KRdp::RdpConnection *newConnection)
             return monitor;
         };
 
-        if (m_virtualMonitor) {
+        if (!persistentOutput.isEmpty()) {
+            // The output, and its layout, are settled just before streaming
+            // starts; see below.
+        } else if (m_virtualMonitor) {
             wrapper->setVirtualMonitor(clientVirtualMonitor(*m_virtualMonitor));
         } else if (m_monitorIndex) {
             wrapper->session->setActiveStream(*m_monitorIndex);
@@ -343,7 +500,15 @@ void SessionController::onNewConnection(KRdp::RdpConnection *newConnection)
             newConnection->close(KRdp::RdpConnection::CloseReason::None);
         });
 
-        wrapper->session->start();
+        if (!persistentOutput.isEmpty()) {
+            SessionWrapper *persistentWrapper = wrapper.get();
+            persistentWrapper->usePersistentOutput(persistentOutput);
+            persistentWrapper->applyLayout({newConnection->clientDesktopSize(), newConnection->clientDesktopScale()}, [persistentWrapper] {
+                persistentWrapper->startOnPersistentOutput();
+            });
+        } else {
+            wrapper->session->start();
+        }
         m_wrappers.push_back(std::move(wrapper));
     });
 }
diff --git a/src/DisplayControl.cpp b/src/DisplayControl.cpp
index d09cb1c..9c9427f 100644
--- a/src/DisplayControl.cpp
+++ b/src/DisplayControl.cpp
@@ -17,14 +17,32 @@ using namespace KRdp;
 
 static UINT display_control_receive_monitor_layout(DispServerContext *context, const DISPLAY_CONTROL_MONITOR_LAYOUT_PDU *pdu)
 {
-    if (pdu->NumMonitors != 1) {
-        return CHANNEL_RC_BAD_CHANNEL;
+    // A client with several monitors, mstsc's "use all monitors" included,
+    // reports all of them. Refusing that with an error, as this used to,
+    // fails the whole Display Control channel, so no later resize arrives
+    // either. The server shows a single output, so follow the client's
+    // primary monitor, or its first when none is marked primary.
+    if (pdu->NumMonitors < 1) {
+        return CHANNEL_RC_OK;
+    }
+    const DISPLAY_CONTROL_MONITOR_LAYOUT *chosen = &pdu->Monitors[0];
+    for (UINT32 i = 0; i < pdu->NumMonitors; ++i) {
+        if (pdu->Monitors[i].Flags & DISPLAY_CONTROL_MONITOR_PRIMARY) {
+            chosen = &pdu->Monitors[i];
+            break;
+        }
     }
 
-    QSize monitorSize = QSize(pdu->Monitors[0].Width, pdu->Monitors[0].Height);
+    QSize monitorSize = QSize(chosen->Width, chosen->Height);
+    // Moving a window between monitors of different DPI changes the scale and
+    // possibly nothing else, so the scale has to travel with the size.
+    const UINT32 scaleFactor = chosen->DesktopScaleFactor;
+    const qreal scale = (scaleFactor >= 100 && scaleFactor <= 500) ? qreal(scaleFactor) / 100.0 : 0;
+    qCInfo(KRDP).nospace() << "KRDP-DISPLAY-CONTROL: layout " << monitorSize << " scaleFactor=" << scaleFactor << " monitors=" << pdu->NumMonitors;
 
     auto c = static_cast<DisplayControl *>(context->custom);
     Q_EMIT c->requestedScreenSizeChanged(monitorSize);
+    Q_EMIT c->requestedLayoutChanged(monitorSize, scale);
 
     return CHANNEL_RC_OK;
 }
