+/// Settling time for a burst of Display Control layouts, such as a window edge being dragged.
+/// Each size it settles on becomes a custom mode that KWin cannot remove again, so this is
+/// long enough to skip the pauses within one drag and apply only where the drag ends.
+static constexpr int LayoutDebounceMs = 1500;
+
+/// Upper bound on one run of the layout helper before it is killed.
+static constexpr int LayoutHelperTimeoutMs = 10000;
+
+/// How often, and how many times, to look for the persistent output among this process's screens.
+static constexpr int PersistentOutputLookupIntervalMs = 100;
+static constexpr int PersistentOutputLookupAttempts = 30;
