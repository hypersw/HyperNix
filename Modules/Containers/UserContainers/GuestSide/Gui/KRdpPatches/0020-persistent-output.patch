+    // Persistent-output mode: every connection streams one existing output,
+    // and its geometry and scale are changed in place to follow the client,
+    // on connect and again whenever the client asks over Display Control.
+    // Nothing is created or destroyed per connection, so a reconnect with the
+    // same geometry changes nothing on screen, and a second connection never
+    // has to wait for the first to finish tearing down.
+    void usePersistentOutput(const QString &outputName)
+    {
+        m_persistentOutput = outputName;
+
+        // Upstream turns every layout request straight into a size request on the
+        // PipeWire stream. Here the size request waits for applyLayout instead,
+        // so that it is debounced and follows the output's scale change.
+        disconnect(connection->displayControl(), &KRdp::DisplayControl::requestedScreenSizeChanged, connection->videoStream(), &KRdp::VideoStream::setRequestedSize);
+
+        // Dragging the client window edge sends a burst of layouts. Apply only
+        // the one it settles on, rather than every mode it passes through.
+        m_layoutDebounce.setSingleShot(true);
+        m_layoutDebounce.setInterval(LayoutDebounceMs);
+        connect(&m_layoutDebounce, &QTimer::timeout, this, [this] {
+            if (m_pendingLayout) {
+                const Layout layout = *m_pendingLayout;
+                m_pendingLayout.reset();
+                applyLayout(layout, {});
+            }
+        });
+        connect(connection->displayControl(), &KRdp::DisplayControl::requestedLayoutChanged, this, [this](const QSize &size, qreal scale) {
+            m_pendingLayout = Layout{size, scale};
+            m_layoutDebounce.start();
+        });
+    }
+
+    struct Layout {
+        QSize size; ///< physical pixels, as RDP reports them
+        qreal scale = 0; ///< 0 when the client sent no usable scale
+    };
+
+    // Ask the lifecycle helper to give the persistent output this layout, then
+    // run then. One helper runs at a time; a request arriving meanwhile waits,
+    // and only the newest of those is applied once it finishes.
+    void applyLayout(const Layout &layout, std::function<void()> then)
+    {
+        if (m_layoutHelper) {
+            m_pendingLayout = layout;
+            return;
+        }
+        const QString handler = qEnvironmentVariable("KRDP_LIFECYCLE_HANDLER");
+        if (handler.isEmpty() || !layout.size.isValid()) {
+            if (then) {
+                then();
+            }
+            return;
+        }
+
+        auto *process = new QProcess(this);
+        m_layoutHelper = process;
+        process->setProcessChannelMode(QProcess::MergedChannels);
+        const QStringList arguments = {QStringLiteral("prepare"),
+                                       m_persistentOutput,
+                                       QString::number(layout.size.width()),
+                                       QString::number(layout.size.height()),
+                                       QString::number(layout.scale, 'g', 4)};
+        auto finish = [this, process, arguments, layout, then](bool ok) {
+            const QByteArray output = process->readAll().trimmed();
+            if (ok) {
+                qInfo().noquote() << "KRDP-LAYOUT: applied" << arguments.join(QLatin1Char(' ')) << (output.isEmpty() ? QString() : QString::fromUtf8(output));
+            } else {
+                qWarning().noquote() << "KRDP-LAYOUT: helper failed" << arguments.join(QLatin1Char(' ')) << QString::fromUtf8(output);
+            }
+            m_layoutHelper = nullptr;
+            process->deleteLater();
+            // KWin 6.8 lets the consumer pick the size of a stream from a resizable
+            // output, which a virtual one is, and never resizes the stream when the
+            // output's mode changes. Without this request the stream keeps the size
+            // it was negotiated at, and the client gets frames of the old size on its
+            // new monitor. If the helper failed, KWin resizes the output to match.
+            if (connection) {
+                connection->videoStream()->setRequestedSize(layout.size);
+            }
+            if (then) {
+                then();
+            }
+            if (m_pendingLayout) {
+                m_layoutDebounce.start();
+            }
+        };
+        connect(process, &QProcess::finished, this, [process, finish](int exitCode, QProcess::ExitStatus status) {
+            finish(status == QProcess::NormalExit && exitCode == 0);
+        });
+        connect(process, &QProcess::errorOccurred, this, [finish](QProcess::ProcessError error) {
+            if (error == QProcess::FailedToStart) {
+                finish(false);
+            }
+        });
+        // A wedged kscreen-doctor must not hold the session hostage.
+        QTimer::singleShot(LayoutHelperTimeoutMs, process, [process] {
+            process->kill();
+        });
+        process->start(handler, arguments);
+    }
+
+    // Stream the persistent output once it is visible to this process. It
+    // normally is already; right after the helper enables it, Qt can learn of
+    // the screen a moment later, so look again briefly before giving up.
+    void startOnPersistentOutput(int attemptsLeft = PersistentOutputLookupAttempts)
+    {
+        const auto screens = QGuiApplication::screens();
+        for (int i = 0; i < screens.size(); ++i) {
+            if (screens.at(i)->name() == m_persistentOutput) {
+                session->setActiveStream(i);
+                session->start();
+                return;
+            }
+        }
+        if (attemptsLeft > 0) {
+            QTimer::singleShot(PersistentOutputLookupIntervalMs, this, [this, attemptsLeft] {
+                startOnPersistentOutput(attemptsLeft - 1);
+            });
+            return;
+        }
+        qWarning() << "KRDP-LAYOUT: output" << m_persistentOutput << "not found; streaming the first screen";
+        session->setActiveStream(0);
+        session->start();
+    }
+
