+    // When the session streams an existing output it knows exactly which
+    // screen that is, so map through it rather than looking one up by name.
+    // RDP coordinates are pixels of the stream, which is the output's current
+    // mode; the screen's geometry is logical, so the ratio of the two is the
+    // output's effective scale, fractional ones included.
+    if (streamedScreen) {
+        const QRect geometry = streamedScreen->geometry();
+        const qreal scale = (streamSize.width() > 0 && geometry.width() > 0)
+            ? qreal(streamSize.width()) / geometry.width()
+            : streamedScreen->devicePixelRatio();
+        return QPointF(geometry.topLeft()) + rdpPosition / scale;
+    }
