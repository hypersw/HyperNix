+void SessionController::scheduleRemoveWrapper(SessionWrapper *wrapper)
+{
+    // Direct slots here run in a signal emitted by wrapper (or by its child
+    // QProcess). Deleting wrapper synchronously deletes a QObject while it is
+    // still emitting. Defer the owning-vector erase until this event unwinds.
+    QPointer<SessionWrapper> guardedWrapper(wrapper);
+    QTimer::singleShot(0, this, [this, guardedWrapper] {
+        if (!guardedWrapper) {
+            return;
+        }
+        qInfo() << "KRDP-TAKEOVER: wrapper-removal-completed" << guardedWrapper.data();
+        removeWrapper(guardedWrapper.data());
+    });
+    qInfo() << "KRDP-TAKEOVER: wrapper-removal-queued" << wrapper;
+}
