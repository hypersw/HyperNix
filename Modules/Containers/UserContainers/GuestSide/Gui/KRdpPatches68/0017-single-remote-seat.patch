 #include <QProcess>
+#include <QTimer>
 
 #include <KLocalizedString>
 
@@ -35,6 +36,12 @@
 
 using namespace Qt::StringLiterals;
 
+/// How long to wait between checks that the incumbent seat has been released.
+static constexpr int SeatHandoverPollMs = 250;
+
+/// Give up waiting after this many checks and activate regardless.
+static constexpr int SeatHandoverAttempts = 40;
+
 class SessionWrapper : public QObject
 {
     Q_OBJECT
@@ -248,6 +255,55 @@ void SessionController::onNewConnection(KRdp::RdpConnection *newConnection)
             return;
         }
 
+        awaitFreeSeat(newConnection, SeatHandoverAttempts);
+    });
+}
+
+// One remote seat. Upstream places no limit on concurrent connections and each
+// brings its own virtual monitor, so a second client extends the desktop rather
+// than taking it over; with differing geometry the windows end up on one
+// monitor and the other is unreachable.
+//
+// The incumbent cannot merely be closed and forgotten. Its virtual output lives
+// until its teardown runs, and the lifecycle helper refuses to finish while more
+// than one RDP output exists ("Timed out waiting for sole RDP output"), which
+// takes the replacement down with it. So close the incumbent, then poll until it
+// has actually released the seat before creating the new session.
+void SessionController::awaitFreeSeat(KRdp::RdpConnection *newConnection, int attemptsLeft)
+{
+    bool seatBusy = false;
+    for (const auto &incumbent : m_wrappers) {
+        if (incumbent->connection && incumbent->connection != newConnection) {
+            seatBusy = true;
+            incumbent->connection->close();
+        }
+    }
+
+    if (!seatBusy) {
+        // Every incumbent is gone, which means its onConnectionDestroyed has
+        // run and the lifecycle helper has already released its output.
+        activateConnection(newConnection);
+        return;
+    }
+
+    if (attemptsLeft <= 0) {
+        qWarning() << "KRDP-SEAT: incumbent did not release the seat in time; activating anyway" << newConnection;
+        activateConnection(newConnection);
+        return;
+    }
+
+    qInfo() << "KRDP-SEAT: waiting for the incumbent to release the seat for" << newConnection;
+    QPointer<KRdp::RdpConnection> guardedConnection(newConnection);
+    QTimer::singleShot(SeatHandoverPollMs, this, [this, guardedConnection, attemptsLeft] {
+        if (!guardedConnection) {
+            return; // the client gave up while we waited
+        }
+        awaitFreeSeat(guardedConnection, attemptsLeft - 1);
+    });
+}
+
+void SessionController::activateConnection(KRdp::RdpConnection *newConnection)
+{
         auto wrapper = std::make_unique<SessionWrapper>(newConnection, makeSession(), m_sni);
         // 6.8 never looks at the client's own desktop: an explicit
         // --virtual-monitor wins, and otherwise a fixed 1024x768 is used. By
@@ -321,7 +377,6 @@ void SessionController::onNewConnection(KRdp::RdpConnection *newConnection)
 
         wrapper->session->start();
         m_wrappers.push_back(std::move(wrapper));
-    });
 }
 
 void SessionController::stopFromSNI()
